{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pnw/cta-section",
	"version": "1.0.0",
	"title": "CTA (Stopka strony)",
	"category": "design",
	"icon": "megaphone",
	"description": "Sekcja call to action do umieszczenia na dole strony.",
	"textdomain": "pnw-hero-3d",
	"attributes": {
		"sectionEyebrow": {
			"type": "string",
			"default": "Masz gotowy pomysł?"
		},
		"sectionTitle": {
			"type": "string",
			"default": "Zamieńmy go w dopracowany wydruk 3D."
		},
		"sectionDescription": {
			"type": "string",
			"default": "Napisz do nas, a wrócimy z propozycją wykonania, materiału i terminu realizacji."
		},
		"primaryCtaText": {
			"type": "string",
			"default": "Wyceń projekt"
		},
		"primaryCtaUrl": {
			"type": "string",
			"default": "/kontakt"
		},
		"secondaryCtaText": {
			"type": "string",
			"default": "Zobacz realizacje"
		},
		"secondaryCtaUrl": {
			"type": "string",
			"default": "/#realizacje"
		},
		"showSecondaryCta": {
			"type": "boolean",
			"default": true
		},
		"surface": {
			"type": "string",
			"default": "mint"
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "pnw-cta-section-editor",
	"style": "pnw-hero-3d-style",
	"editorStyle": "pnw-hero-3d-editor-style"
}
